{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "CuratorOutput",
    "description": "Typed contract: Curator agent → Evaluator agent. Product identification and condition assessment from image analysis.",
    "type": "object",
    "required": [
        "product",
        "condition",
        "images",
        "metadata"
    ],
    "properties": {
        "product": {
            "type": "object",
            "required": [
                "category",
                "brand",
                "identification_confidence",
                "identification_method"
            ],
            "properties": {
                "category": {
                    "type": "string",
                    "description": "eBay category path, e.g. 'Electronics > Headphones > Over-Ear'"
                },
                "type": {
                    "type": "string",
                    "description": "Product type, e.g. 'Wireless Headphones'"
                },
                "brand": {
                    "type": "string",
                    "description": "Brand name or 'Unbranded' if not identifiable"
                },
                "model": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Model name/number, null if unknown"
                },
                "mpn": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Manufacturer part number"
                },
                "upc": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "UPC barcode if visible"
                },
                "color": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "material": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "key_features": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "visible_text": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "All readable text/markings from images"
                },
                "identification_confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "identification_method": {
                    "type": "string",
                    "enum": [
                        "brand_visible",
                        "model_visible",
                        "visual_match",
                        "google_lens",
                        "uncertain"
                    ]
                }
            }
        },
        "condition": {
            "type": "object",
            "required": [
                "grade",
                "confidence"
            ],
            "properties": {
                "grade": {
                    "type": "string",
                    "description": "Inventory API ConditionEnum (same values as evaluator final_grade; see identify-product/references/condition-codes.json)",
                    "enum": [
                        "NEW",
                        "LIKE_NEW",
                        "NEW_OTHER",
                        "NEW_WITH_DEFECTS",
                        "CERTIFIED_REFURBISHED",
                        "EXCELLENT_REFURBISHED",
                        "VERY_GOOD_REFURBISHED",
                        "GOOD_REFURBISHED",
                        "SELLER_REFURBISHED",
                        "USED_EXCELLENT",
                        "USED_VERY_GOOD",
                        "USED_GOOD",
                        "USED_ACCEPTABLE",
                        "PRE_OWNED_EXCELLENT",
                        "PRE_OWNED_FAIR",
                        "FOR_PARTS_OR_NOT_WORKING"
                    ]
                },
                "condition_id": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "description": "eBay condition ID (category-specific, validated by Evaluator)"
                },
                "notes": {
                    "type": "string",
                    "description": "Specific defect descriptions"
                },
                "defects": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "List of individual defects observed"
                },
                "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "tested_by_human": {
                    "type": "boolean",
                    "description": "True only when the seller has said they tested the item. Passed through to evaluator condition.tested_by_human."
                }
            }
        },
        "images": {
            "type": "object",
            "required": [
                "processed_paths",
                "hero_index"
            ],
            "properties": {
                "processed_paths": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Relative paths to processed images"
                },
                "hero_index": {
                    "type": "integer",
                    "description": "Index of best image for listing hero shot"
                },
                "quality_scores": {
                    "type": "array",
                    "items": {
                        "type": "number"
                    },
                    "description": "Per-image quality score (blur/brightness)"
                },
                "rejected": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Paths of images rejected (blurry/dark)"
                }
            }
        },
        "metadata": {
            "type": "object",
            "required": [
                "curator_timestamp",
                "slug"
            ],
            "properties": {
                "curator_timestamp": {
                    "type": "string",
                    "format": "date-time"
                },
                "slug": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]+$"
                },
                "model_used": {
                    "type": "string",
                    "description": "AI model that performed identification"
                },
                "requires_human_review": {
                    "type": "boolean"
                },
                "review_reasons": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "suggested_title": {
            "type": [
                "string",
                "null"
            ],
            "maxLength": 80
        },
        "additional_photos_needed": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    }
}