# Copy to .env (gitignored) and fill in. Real environment variables override this file.
# Where each value comes from: EBAY-API-SETUP.md (public template) or the ebay-api skill.

# sandbox or production. Start with sandbox. Each environment has its own keyset; use the matching keys.
EBAY_ENVIRONMENT=sandbox

# developer.ebay.com > Application Keys: App ID (Client ID) and Cert ID (Client Secret)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# developer.ebay.com > User Tokens > "Get a Token from eBay via Your Application": the RuName
EBAY_REDIRECT_URI=

# Written by `python tools/ebay_api.py exchange-code "<redirect URL>"`; lasts about 18 months
EBAY_USER_REFRESH_TOKEN=

# Optional (defaults shown). Only EBAY_US is tested.
# EBAY_MARKETPLACE_ID=EBAY_US
# EBAY_CONTENT_LANGUAGE=en-US
